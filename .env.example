# Karnataka Smart Transit 2.0 Environment Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL for Production, local embedded storage for offline dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/karnataka_transit_db?schema=public"

# Cryptographic Token Keys (HMAC-SHA256 with rotation support)
# In production, specify a secure 256-bit secret and rotate via active KEY_ID
ACTIVE_KEY_ID="2026-Q3-PRIMARY"
TRANSIT_TOKEN_SECRET="ksrtc_secure_smart_transit_secret_key_prod_v2_9f83a04c"
TRANSIT_TOKEN_PREV_SECRET="ksrtc_legacy_key_v1_backup"

# Turnstile Security & Session Constraints
GATE_ALLOWED_TIME_WINDOW_MINUTES=45
MAX_PASSENGER_SEATS_PER_BOOKING=6

# GPS Fleet Simulator Settings
GPS_SIMULATOR_ENABLED=true
GPS_EMIT_INTERVAL_MS=2500

# Optional Payment Sandbox Provider
PAYMENT_SANDBOX_ENABLED=true
PAYMENT_DEFAULT_CURRENCY="INR"

# Logging & Telemetry
LOG_LEVEL="info"
